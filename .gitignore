__pycache__/
*.pyc
.pytest_cache/
*.swp
*.egg-info/
build/
dist/
.venv/

# Local Claude Code settings (permissions etc.): per-machine, not project config.
.claude/settings.local.json

# Build artifacts: regenerated deterministically with `kdenlive-as-code build`.
# Don't version these unless you want to freeze a specific copy.
*.kdenlive
!examples/**/*.kdenlive.expected
.titles/

# Caches created by kdenlive/melt when opening a project
*.kdenlive.tmp
cachefiles/

# Scratch working copy for manual testing (real footage, not project content)
wc/

# Personal projects, each its own separate local-only git repo
projects/*
!projects/README.md
